# Wedding API configuration. Copy to `.env` (git-ignored) and fill in.
# Variable names match Backend/env.example where they overlap.
# NEVER put any of these values in the React frontend.

NODE_ENV=development
PORT=4100

# MySQL / MariaDB — use a dedicated wedding database (recommended) or the
# existing database. Prefer a separate MySQL user that only has privileges on
# the wedding tables/database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONN_LIMIT=10

# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Salts the hashes used for rate limiting. Required in production.
IP_HASH_SALT=

# Browser origins allowed to call the API with cookies (comma-separated).
# Not needed when the site and API share an origin (Vite proxy / reverse proxy).
ALLOWED_ORIGINS=http://localhost:5173
# Public website URL, used in messages and admin links.
PUBLIC_SITE_URL=http://localhost:5173

# Admin session cookie. In production behind HTTPS keep COOKIE_SECURE=true.
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# Number of reverse proxies in front of the API (cPanel/Passenger, nginx = 1).
# Set to 0 if the API is exposed directly, so X-Forwarded-For can't be spoofed.
TRUST_PROXY=1

# Image storage (relative to Wedding/server or absolute). Must be persistent
# and backed up — see Wedding/database/README.md "Photo storage".
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_MB=15
# Animated GIFs and videos (MP4/WebM). Keep below your proxy's body limit (Cloudflare free: 100 MB).
MAX_GIF_MB=20
MAX_VIDEO_MB=95
UPLOAD_QUOTA_MB=5000
