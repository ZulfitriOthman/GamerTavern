# Production build settings (embedded into the JavaScript at `npm run build`).
# Public values only — never put passwords, tokens or MySQL settings here.

# Wedding API host (origin only). The app calls ${VITE_API_BASE}/api/wedding/…
VITE_API_BASE=https://backend.nanashicollectibles.com

# Not used by the wedding website (it has no real-time features / Socket.IO);
# kept for consistency with the other GamerTavern frontends.
VITE_SOCKET_URL=https://backend.nanashicollectibles.com

# Public site address used in RSVP invite links and QR codes.
VITE_SITE_URL=https://wedding.nanashicollectibles.com
