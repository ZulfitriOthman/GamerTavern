# Frontend configuration (Vite). Only PUBLIC, non-secret values belong here —
# everything is compiled into the JavaScript sent to visitors.
# Database credentials live ONLY in server/.env.
#
# Production values are in .env.production. For local overrides create
# .env.local (git-ignored).

# Wedding API host — ORIGIN ONLY (no path). Requests go to ${VITE_API_BASE}/api/wedding/…
#   https://backend.nanashicollectibles.com  → shared GamerTavern Backend (production)
#   (empty)                                  → same origin; `npm run dev` proxies /api to
#                                              Wedding/server on http://localhost:4100
VITE_API_BASE=

# Not used by the wedding website (no Socket.IO); listed for consistency only.
VITE_SOCKET_URL=

# Public site URL used for invite links and QR codes (defaults to the browser origin).
VITE_SITE_URL=
