# Wedding-Client configuration (Vite). Only PUBLIC values belong here: everything
# is compiled into the JavaScript that guests download. There are NO secrets in
# this app — database credentials and admin passwords live only in the Wedding
# API's own server/.env (D:\Github\GamerTavern\Wedding\server\.env).
#
# Copy to .env.local for development or .env.production for builds.

# Wedding API origin only (no path). Requests go to ${VITE_API_BASE}/api/wedding/…
#   https://<this site's API host>  → this site's OWN API instance (see README → Deployment).
#                                      NOT backend.nanashicollectibles.com — that is the Zulfitri & Mariah API.
#   (empty)                         → same origin; `npm run dev` proxies /api to this site's API
#                                     on http://localhost:4101 (`npm run dev:api`; override with WEDDING_API_PROXY)
VITE_API_BASE=

# Public URL of this site, used for invite links and QR codes (defaults to the browser origin).
VITE_SITE_URL=
