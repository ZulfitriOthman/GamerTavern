# This site's OWN Wedding API instance. Copy to `server.env` (git-ignored) and fill in.
#
# The API code is shared with the Zulfitri & Mariah site (../Wedding/server) but
# this file gives it a SEPARATE database, port and upload folder, so the two
# weddings' RSVPs, wishes, photos and admin accounts never mix.
# Start it with `npm run dev:api` (see README.md). NEVER put these values in the frontend.

NODE_ENV=development
# 4100 is the Zulfitri & Mariah API — keep this one different.
PORT=4101

# A database used ONLY by this site (NOT the one in Wedding/server/.env).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONN_LIMIT=10

# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Not needed in development (the Vite proxy keeps requests same-origin).
# In production: this site's public origin, e.g. https://wedding2.nanashicollectibles.com
ALLOWED_ORIGINS=http://localhost:5174
PUBLIC_SITE_URL=http://localhost:5174

SESSION_TTL_HOURS=12
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12
TRUST_PROXY=1

# Absolute path, or relative to Wedding/server. Must differ from the other site's
# folder. `npm run dev:api` defaults it to Wedding-Client/.api-data/uploads.
UPLOAD_DIRECTORY=
MAX_UPLOAD_MB=15
MAX_GIF_MB=20
MAX_VIDEO_MB=95
UPLOAD_QUOTA_MB=5000
