# Copy to .env.dev (or the equivalent for your environment) and fill in real values.
# Never commit the filled-in file — .env.dev is already gitignored.
# Note: this file is named "env.example" (no leading dot) because the repo's
# .gitignore excludes ".env*" broadly, which would also exclude ".env.example".

PORT=
CLIENT_URL=
EXTRA_ORIGINS=

# MySQL
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_DATABASE=
MYSQL_PASSWORD=

# Auth (see Backend/routes/api/auth.routes.js)
# JWT_SECRET is required in production — the server throws on boot if it's missing.
# In development, an ephemeral in-memory secret is used as a fallback if this is unset,
# which invalidates sessions on every restart. Set it explicitly for stable local sessions.
JWT_SECRET=
JWT_EXPIRES_IN=
BCRYPT_ROUNDS=
RESET_TOKEN_TTL_MIN=

DB_BOOTSTRAP=
USE_DB_PRODUCTS=

# CyberSource payments (see Backend/routes/api/payment.routes.js, and the
# PaymentService abstraction at Backend/services/payment/)
CYBERSOURCE_RUN_ENVIRONMENT=
CYBERSOURCE_MERCHANT_ID=
CYBERSOURCE_KEY_ID=
CYBERSOURCE_SHARED_SECRET=

# Marketplace payment provider selection (see Backend/services/payment/PaymentService.js)
# mock (default, no external calls) | cybersource (requires the three vars above,
# and is not yet usable for real charges — see CyberSourceProvider.js)
PAYMENT_PROVIDER=mock

# Marketplace data encryption (see Backend/modules/encryption.module.js).
# Required before any bank-details write endpoint will work — 64 hex
# characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value. Rotating this key makes previously-encrypted
# bank_details rows undecryptable — there is no key-rotation/re-encryption
# tooling yet.
MARKETPLACE_DATA_ENCRYPTION_KEY=

# SMTP (see Backend/modules/mailer.module.js)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
